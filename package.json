{
  "name": "daily-persona",
  "version": "0.3.0",
  "private": false,
  "type": "module",
  "description": "Deterministic daily persona data protocol with HTTP and MCP adapters",
  "scripts": {
    "test": "node --test",
    "evals": "node evals/run.mjs",
    "http": "node src/http-server.js",
    "mcp": "node src/mcp-stdio.js",
    "cli": "node src/cli.js",
    "check": "node src/cli.js check",
    "verify": "node src/cli.js verify",
    "sign": "node src/sign-cli.js",
    "today": "node src/cli.js today",
    "package:check": "node scripts/check-plugin.mjs",
    "package:zip": "node scripts/package-plugin.mjs",
    "readiness": "node scripts/check-readiness.mjs",
    "host:eval": "node evals/run-host.mjs",
    "smoke:live": "node scripts/smoke-live-endpoint.mjs",
    "rotation:drill": "node scripts/rotation-drill.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "bin": {
    "daily-persona": "src/cli.js",
    "daily-persona-http": "src/http-server.js",
    "daily-persona-mcp": "src/mcp-stdio-sdk.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  }
}
